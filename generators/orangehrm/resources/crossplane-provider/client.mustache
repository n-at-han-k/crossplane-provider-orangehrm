package {{providerName}}

import (
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net/http"
	"strconv"
	"strings"
	"time"
)

// Credentials are what a ProviderConfig's secret holds.
//
// EITHER a JSON document -- {"endpoint": …, "token": …} -- or the bare token,
// which is what {{providerTitle}} itself issues and what a Secret made by
// something else already contains. The endpoint then comes from the
// ProviderConfig's `spec.endpoint`, where it belongs: it is not a secret, and
// requiring a JSON document around the token would mean copying every such
// Secret into one.
type Credentials struct {
	// Endpoint is the base URL of the API, e.g.
	// https://hr.example.com/web/index.php -- everything the API description
	// spells is relative to it. spec.endpoint wins where both are set.
	Endpoint string `json:"endpoint,omitempty"`

	// Token is an {{providerTitle}} OAuth2 access token, sent as
	// `Authorization: Bearer <token>`.
	//
	// A TOKEN RATHER THAN A CLIENT TO MINT ONE WITH, because {{providerTitle}}
	// has no grant a controller can run: src/plugins/orangehrmCoreOAuthPlugin/
	// Server/OAuthServer.php enables exactly two, AuthCodeGrant and
	// RefreshTokenGrant. The first needs a browser and the second needs the
	// first to have happened, so nothing here can obtain a token unattended --
	// `password` and `client_credentials` are both answered
	// `unsupported_grant_type`.
	//
	// The token therefore comes from wherever the instance was provisioned:
	// a long-lived one issued to an API user. A refresh token could be rotated
	// by this client, and is the upgrade path if these ever expire on a
	// schedule someone has to chase.
	Token string `json:"token,omitempty"`
}

// Client is the API client used to interact with the API.
type Client struct {
	BaseURL    string
	HTTPClient *http.Client
	Token      string
}

// NewClient creates a new API client with the given base URL.
func NewClient(baseURL string) *Client {
	return &Client{
		BaseURL: baseURL,
		HTTPClient: &http.Client{
			Timeout: 60 * time.Second,
			// REDIRECTS ARE NOT FOLLOWED. {{providerTitle}} answers a token it
			// does not recognise with a 302 to the login page, which then
			// answers 200 with HTML -- so a followed redirect turns a bad token
			// into "cannot parse the response" and hides what is wrong.
			// Unfollowed, it stays the 302 it is.
			CheckRedirect: func(*http.Request, []*http.Request) error {
				return http.ErrUseLastResponse
			},
		},
	}
}

// NewClientFromCredentials builds a client from a ProviderConfig's secret and
// the endpoint its spec carries.
func NewClientFromCredentials(raw []byte, endpoint string) (*Client, error) {
	creds := Credentials{}

	// A blob that is not JSON is the token itself. Tried in that order because
	// a bare token cannot be mistaken for a document, while a document read as
	// a token would go out as an Authorization header full of braces and fail
	// with a 401 that says nothing about why.
	if err := json.Unmarshal(raw, &creds); err != nil {
		creds.Token = strings.TrimSpace(string(raw))
	}

	if endpoint != "" {
		creds.Endpoint = endpoint
	}

	// An empty endpoint would send every request to a relative URL and fail
	// with something far less obvious than this.
	if creds.Endpoint == "" {
		return nil, fmt.Errorf("no endpoint: set spec.endpoint on the ProviderConfig, or an \"endpoint\" in the credentials")
	}
	if creds.Token == "" {
		return nil, fmt.Errorf("credentials carry no token")
	}

	client := NewClient(strings.TrimRight(creds.Endpoint, "/"))
	client.Token = creds.Token

	return client, nil
}

// DeleteIDs is the body {{providerTitle}}'s delete takes. There is no
// `DELETE /admin/educations/{id}`: there is `DELETE /admin/educations` with
// `{"ids": [7]}`, which is how the API deletes one and how it deletes fifty.
//
// The ids go out as NUMBERS where they are numbers, which is every id this API
// assigns -- the schema says `integer`, and a quoted "7" is refused. A
// non-numeric external name is sent as the string it is, so a document that
// starts naming things does not need this changed.
func DeleteIDs(ids ...string) map[string]any {
	out := make([]any, 0, len(ids))

	for _, id := range ids {
		if number, err := strconv.ParseInt(id, 10, 64); err == nil {
			out = append(out, number)
			continue
		}
		out = append(out, id)
	}

	return map[string]any{"ids": out}
}

// APIError is an unsuccessful response, carrying the status so that a caller
// can tell "it is gone" from "it did not answer".
type APIError struct {
	StatusCode int
	Body       string
}

func (e *APIError) Error() string {
	return fmt.Sprintf("API error (status %d): %s", e.StatusCode, e.Body)
}

// IsNotFound reports whether an error is the API saying the resource is gone.
// ONLY a 404 counts: treating a 500 or a timeout as "does not exist" would
// make a controller provision a second resource and orphan the first.
func IsNotFound(err error) bool {
	var apiErr *APIError

	if !errors.As(err, &apiErr) {
		return false
	}

	return apiErr.StatusCode == http.StatusNotFound
}

// DoRequest executes an HTTP request and returns the response body.
func (c *Client) DoRequest(ctx context.Context, method, path string, body interface{}) ([]byte, error) {
	respBody, _, err := c.doRequest(ctx, method, path, body)

	return respBody, err
}

// DoCreateRequest also hands back the Location header, for an API that answers
// a create with nothing but one. {{providerTitle}} answers the created record,
// so this is the fallback rather than the path -- but a create whose identifier
// goes unrecorded is what leaks a resource, so both are read.
func (c *Client) DoCreateRequest(ctx context.Context, method, path string, body interface{}) ([]byte, string, error) {
	return c.doRequest(ctx, method, path, body)
}

// IDFromLocation reads the identifier off a Location header: it is the last
// segment, whether the server answered an absolute URL or a bare path.
func IDFromLocation(location string) string {
	trimmed := strings.TrimRight(location, "/")

	if cut := strings.LastIndex(trimmed, "/"); cut >= 0 {
		return trimmed[cut+1:]
	}

	return trimmed
}

func (c *Client) doRequest(ctx context.Context, method, path string, body interface{}) ([]byte, string, error) {
	var reqBody io.Reader
	if body != nil {
		jsonBody, err := json.Marshal(body)
		if err != nil {
			return nil, "", fmt.Errorf("error marshaling request body: %w", err)
		}
		reqBody = bytes.NewBuffer(jsonBody)
	}

	req, err := http.NewRequestWithContext(ctx, method, c.BaseURL+path, reqBody)
	if err != nil {
		return nil, "", fmt.Errorf("error creating request: %w", err)
	}

	if body != nil {
		req.Header.Set("Content-Type", "application/json")
	}
	req.Header.Set("Accept", "application/json")
	req.Header.Set("Authorization", "Bearer "+c.Token)

	resp, err := c.HTTPClient.Do(req)
	if err != nil {
		return nil, "", fmt.Errorf("error making request: %w", err)
	}
	defer resp.Body.Close() //nolint:errcheck // nothing useful to do with a close error on a read body.

	respBody, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, "", fmt.Errorf("error reading response body: %w", err)
	}

	// A 302 lands here rather than being followed (see NewClient), so a token
	// the server does not recognise is an error with its own status on it.
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return nil, "", &APIError{StatusCode: resp.StatusCode, Body: string(respBody)}
	}

	return respBody, resp.Header.Get("Location"), nil
}
