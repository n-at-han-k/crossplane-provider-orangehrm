#!/usr/bin/env bash
# The whole build: one OrangeHRM document in, one Crossplane provider out.
#
# What lands in the repo is COMMITTED -- the image compiles what is here, not
# what a regeneration would produce. Run this, look at the diff, commit it.
set -euo pipefail

cd "$(dirname "$0")/.."

SPEC=reference/orangehrm-v2.json

# The API description is GENERATED from OrangeHRM's own source rather than
# published by it -- see hack/gen-spec.sh, which is how this file got here and
# how it is refreshed for a new OrangeHRM release. It is committed, not a
# submodule: there is no upstream repository of it to pin.
test -f "$SPEC" || { echo "missing $SPEC -- run hack/gen-spec.sh"; exit 1; }

# The generated trees, cleared first. Without this a Kind whose paths were
# removed from the document stays behind for ever: the generator writes what
# the document describes and never deletes what it no longer does.
# internal/clients/orangehrm is cleared file by file, because client_test.go
# beside the models is hand-written.
rm -rf apis internal/controller package/crds
rm -f internal/clients/orangehrm/model_*.go internal/clients/orangehrm/client.go

openapi-generator-orangehrm generate \
  -i "$SPEC" \
  -g orangehrm-crossplane \
  -o . \
  --git-host github.com \
  --git-user-id n-at-han-k \
  --git-repo-id crossplane-provider-orangehrm \
  --additional-properties="providerName=orangehrm,providerTitle=OrangeHRM,groupName=orangehrm.crossplane.io,apiVersion=v1alpha1,pathPrefix=/api/v2"

# Every operation in the document is either wired into a controller or a
# search. A resource the generator silently stopped covering is a provider
# that quietly does less than the document says it does.
python3 hack/check-coverage.py

# The build submodule is what the Makefile is written against; it is not in
# the generator's output because it is not a file, it is a checkout.
if [ ! -f build/makelib/common.mk ]; then
  git submodule update --init --recursive build
fi

# Which imports each generated file actually uses depends on which operations
# the document described for it, and that is goimports' job rather than a
# mustache conditional per import.
goimports -w apis internal cmd

# The generator cannot write a go.sum -- only the toolchain knows the hashes.
CGO_ENABLED=0 go mod tidy

# DeepCopy, the crossplane-runtime interface methods and the CRDs. A mustache
# template cannot see a Go type, so these are the two tools that can.
make generate

CGO_ENABLED=0 go build ./...
echo "built clean"
